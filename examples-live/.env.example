# 复制为 .env.local 后填写私密值；本文件不能填写真实密钥。
# 不需要 export；系统环境变量优先。支持整行注释和成对引号，不做 shell 插值。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# 相对路径以本配置文件所在目录为基准；工作区自动创建。
AGT_WORKSPACE=.cache/workspace
AGT_AUDIT_DIR=.cache/live-audit
AGT_ENABLE_BASH=false
# 推荐保持 false：业务文件限工作区；原生严格沙箱不可用时拒绝执行，不自动开放宿主读取。
# 仅影响 Bash 读取范围：false=声明范围；true=宿主读取（仍受系统权限限制）。
# true 不隔离宿主机密读取，结果可能返回给模型；仅在理解边界后显式开启。
# 不扩大写权限、不开放网络、不取消审批；单次 10 秒 / 32768 字节输出。
# HOME 和 ~ 仍指向工作区；不影响 readFile 等只接受相对路径的文件工具。
# 还需 AGT_ENABLE_BASH=true；修改后重启后端。详见 docs/live-agent-guide.md。
AGT_BASH_HOST_READS=false

# Spring Boot 本地端口（修改后同时修改前端 AGT_API_URL）
AGT_SERVER_PORT=8080
